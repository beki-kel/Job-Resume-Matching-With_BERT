# Telegram API Credentials
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# Model Settings
MODEL_PATH=../fine_tuned_telegram_model

# LLM Settings (Gemini)
# Get API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# Telegram Channels (JSON array format)
TELEGRAM_CHANNELS=["@channel1", "@channel2"]

# Scraping Settings
MAX_POSTS_PER_CHANNEL=100
SCRAPE_SLEEP_SECONDS=3.0
SCRAPE_DAYS_BACK=2  # How many days back to scrape
CACHE_TTL_SECONDS=3600  # Fallback TTL (cache auto-refreshes daily)

# Redis
REDIS_URL=redis://localhost:6379/0

# API Settings
DEBUG=false
CORS_ORIGINS=["*"]
